PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/convoy

# Long random string: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me

# URL the website is served from (CORS + invite links). In production this is your https:// site.
CLIENT_ORIGIN=http://localhost:5173

# How long a joining code stays valid, in hours
JOIN_CODE_TTL_HOURS=48

# Routing / geocoding. Leave ORS_API_KEY empty to use free OpenStreetMap services
# (Nominatim + OSRM demo server), fine for development and small groups.
# For production use a free key from https://openrouteservice.org and set it here.
ORS_API_KEY=
# Nominatim requires a User-Agent that identifies you (e.g. your email)
NOMINATIM_USER_AGENT=ConvoyApp/1.0 (you@example.com)

# Testing mode: lets the Journey Leader add simulated vehicles. Default: true in dev, false in production.
ALLOW_SIMULATION=true

# Set to "false" if the React app is hosted elsewhere (Netlify/Vercel). Otherwise, after
# `npm run build` in client/, this server also serves the website.
SERVE_CLIENT=true
